# Buchungsanfragen per SMTP (Zugangsdaten vom Betreiber).
# In Datei .env.local umbenennen und Werte eintragen.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Empfänger der Buchungsanfrage – mehrere Adressen mit Komma trennen
BOOKING_TO_EMAIL=info@foodtruck-landstreicher.de
# Absenderadresse, z. B. "Anfrage <anfrage@foodtruck-landstreicher.de>".
# Leer lassen, um SMTP_USER als Absender zu verwenden.
BOOKING_FROM_EMAIL=